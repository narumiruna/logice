# Local validation only. Generate four distinct values with: openssl rand -hex 32
# Copy this file to .env, then fill every value. Never commit .env.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
OTLP_TOKEN=
# Exactly 64 hex characters (32 bytes AES-256-GCM). Back up separately from PostgreSQL.
AUTH_ENCRYPTION_KEY=
# Exact browser origin; do not substitute 127.0.0.1 after enrollment.
AUTH_ORIGIN=http://localhost:5173
