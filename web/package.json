{
  "name": "logice-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "check": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "vite build",
    "dev": "vite",
    "ci": "npm run check && npm run typecheck && npm test && npm run test:release && npm run build",
    "test:release": "node --test scripts/release.test.mjs",
    "changeset": "changeset",
    "version:release": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release:tag": "node scripts/release.mjs tag",
    "release:github": "node scripts/release.mjs github",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.21",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
