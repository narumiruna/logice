{
  "name": "typescript-template",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/typescript-template.git"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "biome ci .",
    "test": "vitest run",
    "ci": "npm run check && npm test && npm run build",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
